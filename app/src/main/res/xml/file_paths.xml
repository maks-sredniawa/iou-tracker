<?xml version="1.0" encoding="utf-8"?>
<!--
    Two directories, both narrow.

    exports/ holds a manual backup zip on its way to the share sheet (ADR-0005). Cache, deliberately:
    a share the owner abandons is reclaimed by the OS rather than doubling the app's footprint.

    preserved/ holds ADR-0001's pre-wipe database copies and ADR-0005's pre-restore snapshots, and is
    shared only on the owner's own explicit "share" tap — a copy they cannot get off the phone is
    only marginally better than no copy at all. The live database is not listed here.

    Each name is its directory's own, by which ui/common/Share.kt takes back what a share granted.
-->
<paths>
    <cache-path
        name="exports"
        path="exports/" />
    <files-path
        name="preserved"
        path="preserved/" />
</paths>
